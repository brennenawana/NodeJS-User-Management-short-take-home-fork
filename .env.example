# Which location provider looks up zips: fixture (offline), openweathermap or google
LOCATION_PROVIDER=fixture
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=

# Where users are kept: json-file, memory or upstash-redis
STORAGE=json-file
DATA_FILE=data/users.json
# For upstash-redis (Vercel's Upstash integration sets these for you)
KV_REST_API_URL=
KV_REST_API_TOKEN=

API_PORT=8080
