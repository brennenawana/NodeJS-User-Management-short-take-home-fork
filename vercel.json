{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "yarn install --frozen-lockfile",
  "buildCommand": "yarn build && yarn build-storybook && cp -r client/storybook-static client/dist/storybook",
  "outputDirectory": "client/dist",
  "redirects": [
    {
      "source": "/storybook",
      "destination": "/storybook/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "{shared/zips/us.json,product.json}"
    }
  }
}
